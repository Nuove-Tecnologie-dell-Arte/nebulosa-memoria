# Copia questo file in .env e cambia i valori: cp .env.example .env
# Valgono per tutti i modi di accendere la nebulosa (Apri la nebulosa, avvia-server.sh, avvia.py, servizio/).

# La porta del server (il tunnel deve puntare qui)
PORTA=8002

# L'indirizzo pubblico del tunnel (https://...), cosi' il QR porta i telefoni li'.
# Lascialo vuoto se non usi un tunnel.
INDIRIZZO=

# Dove tenere le foto che arrivano e i dati della nebulosa. Vuoto = dentro questa cartella.
# Su un server meglio fuori dal repository, cosi' «git pull» non si blocca e i nomi non finiscono su GitHub:
# la prima volta viene riempita con le foto e i dati del repository. Esempio: CARTELLA_DATI=~/nebulosa-dati
CARTELLA_DATI=

# La chiave per leggere da sole le foto nuove con Claude (serve anche il pacchetto anthropic).
# Resta solo su questo computer: .env non va mai su GitHub.
# ANTHROPIC_API_KEY=
